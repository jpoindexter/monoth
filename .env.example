# ─── Client-side (Vite VITE_ prefix — exposed to browser) ───────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=

# ─── Server-side (Vercel API routes only — never exposed to client) ──────────

# Market data (free tiers available — at minimum set FINNHUB and FRED)
FINNHUB_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
EIA_API_KEY=

# AI features
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Alerts
RESEND_API_KEY=
CRON_SECRET=

# Auth & billing (only needed for user accounts and Stripe billing)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_URL=

# Internal API (optional — leave blank to use direct API calls)
WM_API_URL=
